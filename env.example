# ─────────────────────────────────────────────────────────────────────────────
# Conexión con la Base de Datos de Cursos de Extensión (SharePoint)
#
# Copie este archivo como `.env` y complete lo que corresponda.
# Todo esto también se puede editar desde el botón de Ajustes de la app,
# sin recompilar: útil mientras Registro y Control consigue los IDs.
# ─────────────────────────────────────────────────────────────────────────────

# graph | webhook | mock
VITE_SHAREPOINT_MODE=mock

# ── Opción A · Microsoft Graph (recomendada) ────────────────────────────────
# Requiere una App Registration en Entra ID de tipo SPA con permiso delegado
# Files.ReadWrite.All (y Sites.ReadWrite.All si la biblioteca es de un sitio).
VITE_GRAPH_CLIENT_ID=
VITE_GRAPH_TENANT_ID=
# IDs del archivo «Base de Datos Cursos de Extensión.xlsx», que vive en el
# OneDrive de la Oficina de Estadística:
#   .../personal/jestadisticaplen_enap_edu_co/Documents/
#     Estadística/Bases de Datos/
#     BD Cursos de Ley - Cursos de Extensión/
#     Base de Datos Cursos de Extensión.xlsx
#
# Cómo obtener los IDs, con Graph Explorer y esa misma cuenta:
#   GET /users/jestadisticaplen@enap.edu.co/drive                 → drive-id
#   GET /users/jestadisticaplen@enap.edu.co/drive/root:/Estadística/Bases de Datos/BD Cursos de Ley - Cursos de Extensión/Base de Datos Cursos de Extensión.xlsx
#                                                                 → item-id
# Si el archivo se traslada a una biblioteca de sitio, sirve la ruta larga:
#   GET /sites/{hostname}:/sites/{sitio}                          → site-id
#   GET /sites/{site-id}/drives                                   → drive-id
#   GET /drives/{drive-id}/root:/ruta/al/archivo.xlsx             → item-id
# Forma corta: la cuenta dueña del archivo y su ruta dentro de ese OneDrive.
# La aplicación resuelve sola el drive y el item, así no hace falta Graph
# Explorer —que muchos inquilinos bloquean para los usuarios corrientes—.
VITE_GRAPH_OWNER_UPN=jestadisticaplen@enap.edu.co
VITE_GRAPH_FILE_PATH=Estadística/Bases de Datos/BD Cursos de Ley - Cursos de Extensión/Base de Datos Cursos de Extensión.xlsx

# Forma larga, si se prefiere fijarlos a mano.
VITE_GRAPH_DRIVE_ID=
VITE_GRAPH_ITEM_ID=
VITE_GRAPH_TABLE_ID=Tabla3
VITE_GRAPH_WORKSHEET=Libro No. 2
# Debe coincidir con el Redirect URI registrado en la aplicación.
VITE_GRAPH_REDIRECT_URI=http://localhost:5173

# ── Opción B · Power Automate ───────────────────────────────────────────────
# URL del disparador «When a HTTP request is received» del flujo.
VITE_WEBHOOK_URL=
# Opcional: se envía como cabecera x-api-key.
VITE_WEBHOOK_KEY=
